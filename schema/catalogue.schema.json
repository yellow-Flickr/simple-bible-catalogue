{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-bible-catalogue/schema/catalogue.schema.json",
  "title": "Bible catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "versions"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogueVersion"
      }
    }
  },
  "$defs": {
    "catalogueVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "translationId",
        "name",
        "abbreviation",
        "language",
        "revision",
        "url",
        "sizeBytes",
        "bookCount",
        "verseCount",
        "minSchemaVersion"
      ],
      "properties": {
        "id": {
          "description": "Same format as the version file's id, which must match it: ISO 639-3 language code, a hyphen, then the publisher's abbreviation in lowercase, e.g. eng-kjv. Assigned once; never renamed or reused.",
          "type": "string",
          "pattern": "^[a-z]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "translationId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "abbreviation": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "name"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri-reference",
          "pattern": "\\.json$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "bookCount": {
          "type": "integer",
          "minimum": 0
        },
        "verseCount": {
          "type": "integer",
          "minimum": 0
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "minSchemaVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
